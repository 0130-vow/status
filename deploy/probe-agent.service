[Unit]
Description=Probe agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/probe/agent
ExecStart=/usr/bin/python3 /opt/probe/agent/agent.py --config /opt/probe/agent/config.ini
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
